rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'VgGQEYLf2qdcQkMm389U5RDygED3';
    }

    function validRsvp(documentId) {
      return request.resource.data.keys().hasOnly([
          'id', 'full_name', 'email', 'attendance', 'guest_count',
          'guest_names', 'dietary', 'transport', 'song', 'favorite_movie',
          'message', 'created_at'
        ])
        && request.resource.data.id == documentId
        && request.resource.data.id is string
        && request.resource.data.id.size() <= 128
        && request.resource.data.full_name is string
        && request.resource.data.full_name.size() > 0
        && request.resource.data.full_name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 180
        && request.resource.data.attendance in ['yes', 'no']
        && request.resource.data.guest_count is int
        && request.resource.data.guest_count >= 1
        && request.resource.data.guest_count <= 10
        && request.resource.data.guest_names is string
        && request.resource.data.guest_names.size() <= 600
        && request.resource.data.dietary is string
        && request.resource.data.dietary.size() <= 300
        && request.resource.data.transport in ['yes', 'no']
        && request.resource.data.song is string
        && request.resource.data.song.size() <= 180
        && request.resource.data.favorite_movie is string
        && request.resource.data.favorite_movie.size() <= 180
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.created_at is string
        && request.resource.data.created_at.size() <= 40;
    }

    function validMail() {
      return request.resource.data.keys().hasOnly([
          'to', 'message', 'event_id', 'event_type', 'audience', 'created_at'
        ])
        && request.resource.data.to is list
        && request.resource.data.to.size() >= 1
        && request.resource.data.to.size() <= 2
        && request.resource.data.message is map
        && request.resource.data.message.keys().hasOnly(['subject', 'text', 'html'])
        && request.resource.data.message.subject is string
        && request.resource.data.message.subject.size() > 0
        && request.resource.data.message.subject.size() <= 200
        && request.resource.data.message.text is string
        && request.resource.data.message.text.size() > 0
        && request.resource.data.message.text.size() <= 4000
        && request.resource.data.message.html is string
        && request.resource.data.message.html.size() > 0
        && request.resource.data.message.html.size() <= 12000
        && request.resource.data.event_id is string
        && request.resource.data.event_id.size() > 0
        && request.resource.data.event_id.size() <= 128
        && request.resource.data.event_type in ['rsvp', 'gift']
        && request.resource.data.audience in ['guest', 'couple']
        && request.resource.data.created_at is string
        && request.resource.data.created_at.size() <= 40;
    }

    function validCoupleMail() {
      return request.resource.data.audience == 'couple'
        && request.resource.data.to == [
          'gboetsch93@gmail.com', 'maria.c.obregon@hotmail.com'
        ];
    }

    function validGuestMail() {
      return request.resource.data.audience == 'guest'
        && request.resource.data.to.size() == 1
        && (
          (
            request.resource.data.event_type == 'rsvp'
            && get(/databases/$(database)/documents/rsvps/$(request.resource.data.event_id)).data.email
              == request.resource.data.to[0]
          )
          ||
          (
            request.resource.data.event_type == 'gift'
            && get(/databases/$(database)/documents/gift_confirmations/$(request.resource.data.event_id)).data.email
              == request.resource.data.to[0]
          )
        );
    }

    match /rsvps/{documentId} {
      allow create: if (request.auth == null || isAdmin()) && validRsvp(documentId);
      allow update: if request.auth == null
        && validRsvp(documentId)
        && request.resource.data.email == resource.data.email
        && request.resource.data.id == resource.data.id;
      allow read, update, delete: if isAdmin();
    }

    match /rsvp_history/{documentId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    match /gift_confirmations/{documentId} {
      allow create: if (request.auth == null || isAdmin())
        && request.resource.data.keys().hasOnly([
          'id', 'gift_id', 'gift_name', 'amount', 'giver_name',
          'email', 'dedication', 'status', 'created_at'
        ])
        && request.resource.data.id is string
        && request.resource.data.id.size() <= 128
        && request.resource.data.gift_id is string
        && request.resource.data.gift_id.size() > 0
        && request.resource.data.gift_id.size() <= 100
        && request.resource.data.gift_name is string
        && request.resource.data.gift_name.size() > 0
        && request.resource.data.gift_name.size() <= 180
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 100000000
        && request.resource.data.giver_name is string
        && request.resource.data.giver_name.size() > 0
        && request.resource.data.giver_name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 180
        && request.resource.data.dedication is string
        && request.resource.data.dedication.size() > 0
        && request.resource.data.dedication.size() <= 600
        && request.resource.data.status == 'transfer_declared'
        && request.resource.data.created_at is string
        && request.resource.data.created_at.size() <= 40;
      allow read, update, delete: if isAdmin();
    }

    match /mail/{documentId} {
      allow create: if (request.auth == null || isAdmin())
        && validMail()
        && (validCoupleMail() || validGuestMail());
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
